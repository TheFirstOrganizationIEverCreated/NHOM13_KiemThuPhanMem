<Window
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Height="450"
    Title="Exercise16"
    Width="800"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.Exercise16"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoftwareTestingExercisesOfChapter4And5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="n = " />
                <TextBox
                    Height="20"
                    Text="{Binding NString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="NTextBoxTextChangedEventHandler"
                    Width="100" />
            </StackPanel>

            <TextBlock HorizontalAlignment="Center" Text="{Binding Notification, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Window>
