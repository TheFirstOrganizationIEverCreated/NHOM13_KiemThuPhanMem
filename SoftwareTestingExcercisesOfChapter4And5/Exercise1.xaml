<Window
    Height="450"
    Title="Execise1"
    Width="800"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.Exercise1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoftwareTestingExercisesOfChapter4And5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Label
                Content="x = "
                Grid.Row="0"
                HorizontalAlignment="Left"
                Margin="280,0,0,0"
                VerticalAlignment="Center"
                Width="30" />
            <TextBox
                Grid.Row="0"
                Height="20"
                HorizontalAlignment="Left"
                Margin="350,0,0,0"
                Text="{Binding X, Mode=OneWayToSource}"
                VerticalAlignment="Center"
                Width="100" />

            <Label
                Content="f(x) = "
                Grid.Row="1"
                HorizontalAlignment="Left"
                Margin="280,0,0,0"
                VerticalAlignment="Center"
                Width="40" />
            <TextBlock
                Grid.Row="1"
                Height="20"
                HorizontalAlignment="Left"
                Margin="350,0,0,0"
                Text="{Binding FunctionFValue, Mode=OneWay}"
                VerticalAlignment="Center"
                Width="100" />
        </Grid>

        <Button
            Click="ClickedCalculateFunctionFButton"
            Content="Tính f(x)"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Window>
