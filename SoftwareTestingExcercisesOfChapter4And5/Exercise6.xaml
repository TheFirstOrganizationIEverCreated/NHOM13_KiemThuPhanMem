<Window
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Height="450"
    Title="Exercise6"
    Width="800"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.Exercise6"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoftwareTestingExercisesOfChapter4And5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding FormConfirmNVisibility, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Label Content="n = " />
                <TextBox
                    Height="20"
                    Text="{Binding NString, Mode=OneWayToSource}"
                    TextChanged="TextBoxNChangedText"
                    Width="100" />
            </StackPanel>

            <TextBlock Height="20" Text="{Binding Notification, Mode=OneWay}" />

            <Button
                Click="ClickedButtonConfirmN"
                Content="Xác nhận n"
                HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding FormConfirmUVisibility, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Label Content="số nguyên a = " />
                <TextBox
                    Height="20"
                    Text="{Binding AString, Mode=OneWayToSource}"
                    TextChanged="TextBoxAChangedText"
                    Width="100" />
            </StackPanel>

            <TextBlock Height="20" Text="{Binding Notification, Mode=OneWay}" />

            <Button
                Click="ClickedButtonAddIntegerToU"
                Content="Thêm a vào dãy số U"
                HorizontalAlignment="Center" />

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Label Content="U = " />
                <TextBox
                    Height="20"
                    IsReadOnly="True"
                    Text="{Binding UString, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>