<Window
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Height="450"
    Title="Exercise6"
    Width="800"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.Exercise6"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoftwareTestingExercisesOfChapter4And5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel Orientation="Vertical" Visibility="{Binding FormConfirmNVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                VerticalAlignment="Center">
                <Label Content="n = " />
                <TextBox
                    Height="20"
                    Text="{Binding NString, Mode=OneWayToSource}"
                    TextChanged="TextBoxNChangedText"
                    Width="100" />
            </StackPanel>

            <TextBlock
                Height="20"
                Text="{Binding Notification, Mode=OneWay}"
                Width="250" />

            <Button
                Click="ClickedButtonConfirmN"
                Content="Xác nhận n"
                HorizontalAlignment="Center" />
        </StackPanel>


    </Grid>
</Window>
