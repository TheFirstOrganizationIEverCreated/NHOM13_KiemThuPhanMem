<Window
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Height="450"
    Title="Exercise7"
    Width="800"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.Exercise7"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoftwareTestingExercisesOfChapter4And5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Label Content="n = " />
                <TextBox
                    Height="20"
                    Text="{Binding NString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="NTextBoxChangedText"
                    Width="100" />
            </StackPanel>

            <TextBlock
                Height="20"
                Text="{Binding Notification, Mode=OneWay}"
                TextAlignment="Center" />

            <StackPanel Visibility="{Binding OutputsSectionVisibility, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="Các giá trị chia hết cho 3 trong [1 ; n]: " />
                    <TextBox IsReadOnly="True" Text="{Binding StringAllMultipleOf3From1ToN, Mode=OneWay}" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="Số lượng giá trị chia hết cho 3 trong [1 ; n]: " />
                    <TextBox IsReadOnly="True" Text="{Binding AmountOfMultipleOf3From1ToN, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
