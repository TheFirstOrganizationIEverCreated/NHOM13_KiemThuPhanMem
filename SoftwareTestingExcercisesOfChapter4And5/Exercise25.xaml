<Window
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Height="450"
    Title="Exercise25"
    Width="800"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.Exercise25"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoftwareTestingExercisesOfChapter4And5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="F = " />
                <TextBox
                    Text="{Binding FString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="FTextBoxTextChangedEventHandler"
                    Width="100" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="S = " />
                <TextBox
                    Text="{Binding SString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="STextBoxTextChangedEventHandler"
                    Width="100" />
            </StackPanel>

            <TextBlock HorizontalAlignment="Center" Text="{Binding Notification, Mode=OneWay}" />

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="p = " />
                <TextBlock Text="{Binding PString, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
