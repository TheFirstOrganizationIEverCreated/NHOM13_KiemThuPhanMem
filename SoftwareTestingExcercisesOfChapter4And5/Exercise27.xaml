<Window
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Height="450"
    Title="Exercise27"
    Width="800"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.Exercise27"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoftwareTestingExercisesOfChapter4And5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="x = " />
                <TextBox
                    Text="{Binding XString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="XTextBoxTextChangedEventHandler"
                    Width="100" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="y = " />
                <TextBox
                    Text="{Binding YString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="YTextBoxTextChangedEventHandler"
                    Width="100" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="a = " />
                <TextBox
                    Text="{Binding AString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBoxATextChangedEventHandler"
                    Width="100" />
            </StackPanel>

            <TextBlock HorizontalAlignment="Center" Text="{Binding Notification, Mode=OneWay}" />

            <TextBlock Text="{Binding Conclusion, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Window>