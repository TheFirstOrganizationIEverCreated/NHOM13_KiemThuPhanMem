<Window
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Height="450"
    Title="MainWindow"
    Width="800"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoftwareTestingExercisesOfChapter4And5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ComboBox
            HorizontalAlignment="Center"
            ItemsSource="{Binding Exercises, Mode=OneWay}"
            Margin="0,195,0,0"
            SelectedItem="{Binding SelectedExercise, Mode=TwoWay}"
            VerticalAlignment="Top"
            Width="120" />
        <Button
            Click="ClickedRunButton"
            Content="Run"
            Height="30"
            HorizontalAlignment="Center"
            Margin="0,240,0,0"
            VerticalAlignment="Top"
            Width="50" />
    </Grid>
</Window>