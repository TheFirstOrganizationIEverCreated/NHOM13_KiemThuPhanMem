<Window
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Height="350"
    Title="Exercise26"
    Width="700"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.Exercise26"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoftwareTestingExercisesOfChapter4And5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="y = " />
                <TextBlock Text="{Binding YString, Mode=OneWay}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="Trung bình cộng các số trong y = " />
                <TextBlock Text="{Binding AverageOfYSequenceString, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
