<Window
    x:Class="SoftwareTestingExercisesOfChapter4And5.Exercise26"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoftwareTestingExercisesOfChapter4And5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Exercise26"
    Width="520"
    Height="350"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,8"
            Orientation="Horizontal">
            <Button
                Name="BtnCalc"
                Padding="6,3"
                Click="BtnCalc_Click">
                Tính dãy
            </Button>
            <TextBlock
                Name="LblCount"
                Margin="12,0,0,0"
                VerticalAlignment="Center" />
        </StackPanel>

        <ListBox
            Name="ListY"
            Grid.Row="1"
            FontFamily="Consolas" />

        <StackPanel
            Grid.Row="2"
            Margin="0,8,0,0"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="Bold"
                Text="Trung bình: " />
            <TextBlock
                Name="TxtAverage"
                Margin="6,0,0,0"
                VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
