<Window
    Height="350"
    Title="Exercise26"
    Width="520"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.Exercise26"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoftwareTestingExercisesOfChapter4And5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,8"
            Orientation="Horizontal">
            <Button
                Click="BtnCalc_Click"
                Name="BtnCalc"
                Padding="6,3">
                Tính dãy
            </Button>
            <TextBlock
                Margin="12,0,0,0"
                Name="LblCount"
                VerticalAlignment="Center" />
        </StackPanel>

        <ListBox
            FontFamily="Consolas"
            Grid.Row="1"
            Name="ListY" />

        <StackPanel
            Grid.Row="2"
            Margin="0,8,0,0"
            Orientation="Horizontal">
            <TextBlock
                FontWeight="Bold"
                Text="Trung bình: "
                VerticalAlignment="Center" />
            <TextBlock
                Margin="6,0,0,0"
                Name="TxtAverage"
                VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
