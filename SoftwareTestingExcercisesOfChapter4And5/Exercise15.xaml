<Window
    x:Class="SoftwareTestingExercisesOfChapter4And5.Exercise15"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Exercise15"
    Width="500"
    Height="250"
    WindowStartupLocation="CenterScreen"
    DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <TextBlock Text="Nhập số km đi được:" FontSize="14"/>
            <TextBox
                Text="{Binding KmString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="KmTextBox_TextChanged"
                Width="150" Margin="0,5"/>

            <TextBlock Text="{Binding Notification}" Foreground="Red" Margin="0,5"/>
            <TextBlock Text="{Binding Result}" Foreground="Blue" FontWeight="Bold" FontSize="14" Margin="0,10"/>
        </StackPanel>
    </Grid>
</Window>
