<Window
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Height="450"
    Title="Exercise9"
    Width="800"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.Exercise9"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoftwareTestingExercisesOfChapter4And5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="R = " />
                <TextBox
                    Height="20"
                    Text="{Binding RString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="RTextBoxChangedTextEventHandler"
                    Width="100" />
            </StackPanel>

            <TextBlock
                Height="20"
                TextAlignment="Center"
                x:Name="notificationTextBlock" />

            <TextBlock
                Height="20"
                TextAlignment="Center"
                x:Name="conclusionTextBlock" />
        </StackPanel>
    </Grid>
</Window>
