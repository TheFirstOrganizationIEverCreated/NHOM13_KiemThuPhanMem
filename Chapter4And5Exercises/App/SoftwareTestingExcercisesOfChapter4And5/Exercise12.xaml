<Window
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Height="450"
    Title="Exercise12"
    Width="800"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.Exercise12"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoftwareTestingExercisesOfChapter4And5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            x:Name="confirmNSection">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="n = " />
                <TextBox
                    Height="20"
                    Text="{Binding NString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="NTextBoxTextChangedEventHandler"
                    Width="100" />
            </StackPanel>

            <TextBlock Text="{Binding Notification, Mode=OneWay}" TextAlignment="Center" />

            <Button
                Click="ClickedConfirmNButtonEventHandler"
                Content="Xác nhận n"
                HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            x:Name="confirmUSection">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="số nguyên a = " />
                <TextBox
                    Text="{Binding AString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBoxATextChangedEventHandler"
                    Width="100" />
            </StackPanel>

            <TextBlock Text="{Binding Notification, Mode=OneWay}" TextAlignment="Center" />

            <Button
                Click="ClickedConfirmButtonAEventHandler"
                Content="Thêm a vào U"
                HorizontalAlignment="Center" />

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="U = " />
                <TextBlock Text="{Binding UString, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            x:Name="conclusionSection">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="các số chia hết cho 3 trong U: " />
                <TextBlock x:Name="multipleOf3IntegersInUTextBlock" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="Tổng các số chia hết cho 3 trong U: " />
                <TextBlock x:Name="sumOfMultipleOf3IntegersInUTextBlock" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
