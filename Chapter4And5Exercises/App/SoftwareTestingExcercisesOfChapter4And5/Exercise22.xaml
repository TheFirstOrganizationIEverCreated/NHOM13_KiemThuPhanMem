<Window
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Height="450"
    Title="Exercise22"
    Width="800"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.Exercise22"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <!--  Nhập m  -->
        <StackPanel x:Name="confirmMSection">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="m = " />
                <TextBox
                    Text="{Binding TString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TTextBoxTextChangedEventHandler"
                    Width="100" />
            </StackPanel>
            <TextBlock HorizontalAlignment="Center" Text="{Binding Notification, Mode=OneWay}" />
            <Button
                Click="ConfirmTButton_Click"
                Content="Xác nhận m"
                HorizontalAlignment="Center" />
        </StackPanel>

        <!--  Nhập dãy A  -->
        <StackPanel Visibility="Collapsed" x:Name="confirmASection">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="A = " />
                <TextBox Text="{Binding AString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" Width="100" />
            </StackPanel>
            <Button
                Click="ConfirmAButton_Click"
                Content="Thêm A"
                HorizontalAlignment="Center" />
            <TextBox
                Height="30"
                IsReadOnly="True"
                Width="200"
                x:Name="uTextBox" />
        </StackPanel>

        <!--  Kết quả  -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            x:Name="resultSection">
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                x:Name="averageTextBlock" />
        </StackPanel>
    </StackPanel>
</Window>
