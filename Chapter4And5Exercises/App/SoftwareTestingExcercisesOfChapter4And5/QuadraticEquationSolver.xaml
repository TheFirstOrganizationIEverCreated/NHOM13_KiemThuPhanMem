<Window
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Height="450"
    Title="QuadraticEquationSolver"
    Width="800"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.QuadraticEquationSolver"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoftwareTestingExercisesOfChapter4And5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            x:Name="loginSection">
            <TextBlock
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Text="ĐĂNG NHẬP HỆ THỐNG" />

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="User name " Width="60" />
                <TextBox
                    Text="{Binding UserName, Mode=OneWayToSource}"
                    TextChanged="UserNameTextBoxTextChangedEventHandler"
                    Width="100" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="Password " Width="60" />
                <PasswordBox
                    PasswordChanged="PasswordBoxPasswordChangedEventHandler"
                    Width="100"
                    x:Name="passwordBox" />
            </StackPanel>

            <TextBlock HorizontalAlignment="Center" Text="{Binding Notification, Mode=OneWay}" />

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    Click="ClickedExitButtonEventHandler"
                    Content="Exit"
                    HorizontalAlignment="Right"
                    Margin="0,0,20,0"
                    Width="50" />

                <Button
                    Click="ClickedLoginButtonEventHandler"
                    Content="Login"
                    Width="50" />
            </StackPanel>
        </StackPanel>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            x:Name="quadraticArgumentsSection">
            <TextBlock
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Text="NHẬP DỮ LIỆU ĐẦU VÀO" />

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="a(*) " Width="30" />
                <TextBox Text="{Binding AString, Mode=OneWayToSource}" Width="100" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="b(*) " Width="30" />
                <TextBox Text="{Binding BString, Mode=OneWayToSource}" Width="100" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="c(*) " Width="30" />
                <TextBox Text="{Binding CString, Mode=OneWayToSource}" Width="100" />
            </StackPanel>

            <TextBlock HorizontalAlignment="Center" Text="{Binding Notification, Mode=OneWay}" />

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    Content="Input"
                    HorizontalAlignment="Right"
                    Margin="0,0,20,0"
                    Width="50" />

                <Button Content="Again" Width="50" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>