<Window
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Height="450"
    Title="MainWindow"
    Width="800"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoftwareTestingExercisesOfChapter4And5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ComboBox
                HorizontalAlignment="Center"
                ItemsSource="{Binding Exercises, Mode=OneWay}"
                SelectedItem="{Binding SelectedExercise, Mode=TwoWay}" />

            <Button
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Click="ClickedRunButton"
                Content="Run"
                Height="30"
                Width="50" />
        </StackPanel>
    </Grid>
</Window>