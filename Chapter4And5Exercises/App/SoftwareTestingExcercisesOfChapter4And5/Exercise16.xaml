<Window
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Height="450"
    Title="Exercise16"
    Width="800"
    mc:Ignorable="d"
    x:Class="SoftwareTestingExercisesOfChapter4And5.Exercise16"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel
        HorizontalAlignment="Center"
        Margin="20"
        VerticalAlignment="Center">

        <!--  Nhập n  -->
        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            x:Name="confirmNSection">
            <TextBlock Text="n = " VerticalAlignment="Center" />
            <TextBox
                Height="20"
                Text="{Binding NString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="NTextBoxTextChangedEventHandler"
                Width="100" />
        </StackPanel>

        <TextBlock HorizontalAlignment="Center" Text="{Binding Notification, Mode=OneWay}" />

        <Button
            Click="ClickedConfirmNButtonEventHandler"
            Content="Xác nhận n"
            HorizontalAlignment="Center"
            x:Name="ClickedConfirmNButton" />

        <!--  Nhập dãy U  -->
        <StackPanel Visibility="Collapsed" x:Name="confirmUSection">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="a = " VerticalAlignment="Center" />
                <TextBox
                    Height="20"
                    Text="{Binding AString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBoxAChangedTextEventHandler"
                    Width="100" />
            </StackPanel>

            <TextBlock HorizontalAlignment="Center" x:Name="aNotificationTextBlock" />

            <Button
                Click="ClickedConfirmAButtonEventHandler"
                Content="Thêm a vào dãy U"
                HorizontalAlignment="Center" />

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="U = " VerticalAlignment="Center" />
                <TextBox
                    IsReadOnly="True"
                    Width="300"
                    x:Name="uTextBox" />
            </StackPanel>
        </StackPanel>

        <!--  Kết quả  -->
        <StackPanel Visibility="Collapsed" x:Name="resultSection">
            <TextBlock
                FontSize="14"
                FontWeight="Bold"
                x:Name="maxElementTextBlock" />
            <TextBlock
                FontSize="14"
                FontWeight="Bold"
                x:Name="positionTextBlock" />
        </StackPanel>

    </StackPanel>
</Window>
