@page
@model WebApplication2.Pages.CreateSanModel
@{
}
<br />
<h2>New Client</h2>
@if (Model.errorMessage.Length > 0)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>@Model.errorMessage</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria
                label="Close"></button>
    </div>
}
@*Form submit dữ liệu*@
<form method="post">
    <div class="row mb-3">
        <label class="col-sm3 col-form-label">Name</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="name"
                   value="@Model.placesInfo.Name">
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm3 col-form-label">Loại Sân</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="type"
                   value="@Model.placesInfo.Type">
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm3 col-form-label">Giá Thuê</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="price"
                   value="@Model.placesInfo.Price">
        </div>
    </div>
    <div class="row mb-3">
        <label class="col-sm3 col-form-label">Vị trí</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="location"
                   value="@Model.placesInfo.Location">
        </div>
    </div>
    @*button submit và cancel*@ 
    <div class="row mb-3">
        <div class="col-sm-3 d-grid">
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
        <div class="col-sm-3 d-grid">
            <a class="btn btn-outline-primary" href="/Clients" role="button">Cancel</a>
            @*Cancel thì trở về trang /Clients/index*@ 
        </div>
    </div>

</form> 