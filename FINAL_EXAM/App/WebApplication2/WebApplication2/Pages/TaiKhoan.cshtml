@page
@model TaiKhoanModel
@{
}
<!-- Main Section -->
<div class="auth-container">
     <div class="tabs"> 
         <div id="login-tab" class="active">Đăng nhập</div> 
         <div id="register-tab">Đăng ký</div> 
     </div> 

    <!-- Form Đăng Nhập -->
    <form id="login-form" class="form active" method="post">
        <input type="hidden" name="formAction" value="login" />
        <input type="email" name="LoginEmail" placeholder="Email" value="@Model.clientInfo.Email" required />
        <input type="password" name="LoginPassword" placeholder="Mật khẩu" value="@Model.clientInfo.Password" required />
        <button type="submit">Đăng nhập</button>
         <div class="link">Chưa có tài khoản? <a href="#" id="switch-to-register">Đăng ký ngay</a></div> 
    </form>

    <!-- Form Đăng Ký --> 
     <form id="register-form" class="form" method="post"> 
         <input type="hidden" name="formAction" value="register" /> 
         <input type="text" name="name" value="@Model.clientInfo.Name" placeholder="Họ và Tên" required  /> 
         <input type="email" name="email" value="@Model.clientInfo.Email" placeholder="Email" required   /> 
		 <input type="text" name="phone" value="@Model.clientInfo.Phone" placeholder="SĐT" required /> 
         <input type="password" name="RegisterPassword" value="@Model.clientInfo.Password" placeholder="Mật khẩu" required  /> 
         <input type="password" name="RegisterConfirm" placeholder="Xác nhận mật khẩu" required /> 
         <button type="submit">Đăng ký</button> 
         <div class="link">Đã có tài khoản? <a href="#" id="switch-to-login">Đăng nhập</a></div> 
     </form>
</div>
<script>
    const loginTab = document.getElementById('login-tab');
    const registerTab = document.getElementById('register-tab');
    const loginForm = document.getElementById('login-form');
    const registerForm = document.getElementById('register-form');
    const switchToLogin = document.getElementById('switch-to-login');
    const switchToRegister = document.getElementById('switch-to-register');

    loginTab.onclick = () => {
        loginTab.classList.add('active');
        registerTab.classList.remove('active');
        loginForm.classList.add('active');
        registerForm.classList.remove('active');
    };

    registerTab.onclick = () => {
        registerTab.classList.add('active');
        loginTab.classList.remove('active');
        registerForm.classList.add('active');
        loginForm.classList.remove('active');
    };

    switchToLogin.onclick = (e) => {
        e.preventDefault();
        loginTab.click();
    };

    switchToRegister.onclick = (e) => {
        e.preventDefault();
        registerTab.click();
    };
</script>
@if (!string.IsNullOrEmpty(Model.errorMessage))
{
    <div class="error">@Model.errorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.loginError))
{
    <div class="error">@Model.loginError</div>
}

